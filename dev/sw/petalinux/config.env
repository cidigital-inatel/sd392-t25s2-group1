# Configuração padrão do fluxo PetaLinux (ZCU102 + NPU na PL).
#
# Não edite este arquivo para ajustes da sua máquina: crie um config.local.env
# ao lado dele (ignorado pelo git) ou exporte a variável antes de chamar o script.
# Ex.: PROJECT_NAME=teste ./plx.sh create

: "${PETALINUX_VERSION:=2024.2}"

# Onde o PetaLinux é instalado (precisa estar no filesystem Linux, não em /mnt/c).
: "${PETALINUX_DIR:=$HOME/petalinux/$PETALINUX_VERSION}"

# Onde os projetos são criados (também no filesystem Linux).
: "${PROJECTS_DIR:=$HOME/projetos}"
: "${PROJECT_NAME:=zcu102-npu}"

# Cache compartilhado entre projetos (downloads do Yocto e sstate-cache).
: "${SHARED_DIR:=$HOME/petalinux-shared}"

# Tarefas de compilação em paralelo. Cada uma pode usar ~2 GB de RAM:
# aumente só se o WSL/host tiver memória de sobra.
: "${PARALLEL_JOBS:=3}"

# Instalador e BSP. Vazio = procura automaticamente em installer/ e bsp/.
: "${INSTALLER:=}"
: "${BSP:=}"

# Hardware exportado pelo Vivado (.xsa), usado com o config
# Vazio = mantém o hardware atual do projeto (o do BSP, se nenhum XSA foi importado).
: "${XSA:=}"
